# Simulation artifacts
sim/build/
*.vvp
*.vcd
*.fst
*.lxt2

# Gowin EDA build OUTPUT (regenerated every build) - but NOT the whole impl/
# dir: impl/<name>_process_config.json holds the per-project build settings
# (SystemVerilog 2017 + DONE/READY/SSPI dual-purpose pins). Those MUST be tracked
# or a fresh clone builds with wrong defaults and fails (SV parse + P&R pin errors).
impl/pnr/
impl/gwsynthesis/
impl/temp/
**/impl/pnr/
**/impl/gwsynthesis/
**/impl/temp/
*.fs
*.bit
*.rpt.html
*.rpt.txt
gwsynthesis/
*.bak
# Gowin P&R/synth byproducts that escape the dir patterns above (belt-and-braces)
*.binx
*.db
*.timing_paths
cmd.do
device.cfg
rtl_parser*.json
rtl_parser.result
# stray top-level Gowin project output dir (the GUI sometimes writes here)
/Groovy_TaNGer/impl/
# stray iverilog default output
a.out
*.gprj.user

# Claude Code local (per-user) settings
.claude/settings.local.json

# Editor
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Gowin proprietary IP (regenerate locally; see each dir's README)
rtl/board/tang_primer_20k/video/dvi_tx/dvi_tx.v
rtl/board/tang_primer_20k/video/dvi_tx/dvi_tx.vo
rtl/board/tang_primer_20k/video/dvi_tx/*.ipc
# Gowin DDR3 Memory Interface IP (encrypted, regenerate via IP wizard; see ddr3_ip/README)
rtl/board/tang_primer_20k/gwddr3video/ddr3_ip/ddr3_mi.v
rtl/board/tang_primer_20k/gwddr3video/ddr3_ip/ddr3_mi.vo
rtl/board/tang_primer_20k/gwddr3video/ddr3_ip/temp/
