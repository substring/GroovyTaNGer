 //============================================================
+//  renderer_nogpu::nogpu_set_txtime
+//  (Linux) lets every datagram carry its own departure time
+//============================================================
+
+bool renderer_nogpu::nogpu_set_txtime()
+{
+	#if defined(__linux__) && defined(SO_TXTIME)
+	// CLOCK_MONOTONIC is the clock fq schedules with, and needs no privilege
+	sock_txtime txtime = {};
+	txtime.clockid = CLOCK_MONOTONIC;
+	txtime.flags = 0;
+	return setsockopt(m_sockfd, SOL_SOCKET, SO_TXTIME, &txtime, sizeof(txtime)) == 0;
+	#else
+	return false;
+	#endif
+}
+
+//============================================================
+//  renderer_nogpu::nogpu_send_lines
+//
+//  Line pacing: a receiver that races the beam with a small line ring (Groovy_TaNGer:
+//  32 lines) must get every line close to the raster's time for it, not as early as
+//  the link allows. -mister_pacing does it with a byte rate, which only matches lines
+//  when every line has the same size (raw). With compression a line can be 2 bytes or
+//  a full raw line, so here every datagram gets its own departure time instead: the
+//  raster time of the first line it carries, counted from t0 (the CMD_BLIT). The fq
+//  qdisc holds each datagram until then (SO_TXTIME); sendmsg still returns at once,
+//  the emulation thread never waits.
+//
+//  A datagram is cut at MAX_LINES_PER_DGRAM lines, so its last line is never more
+//  than that many lines early (a 1472-byte datagram can hold ~50 lines of a flat QOI
+//  picture). buffer + m_line_offset[0..lines] describe the payload, line by line.
+//============================================================
+
+#define MAX_LINES_PER_DGRAM 4
+
+void renderer_nogpu::nogpu_send_lines(const char *buffer, int lines, uint64_t t0_ns)
+{
+	#if defined(__linux__) && defined(SO_TXTIME)
+	const uint32_t end = m_line_offset[lines];
+	const double line_ns = m_line_period * 1000000.0;
+	uint32_t offset = 0;
+	int line = 0;
+
+	while (offset < end)
+	{
+		// first line of this datagram: the one that holds its first byte
+		while (m_line_offset[line + 1] <= offset)
+			line++;
+
+		const int last = std::min(line + MAX_LINES_PER_DGRAM, lines);
+		const uint32_t stop = std::min(offset + 1472, m_line_offset[last]);
+		nogpu_send_at(buffer + offset, stop - offset, t0_ns + (uint64_t)(line * line_ns));
+		offset = stop;
+	}
+	#endif
+}
+
+//============================================================
+//  renderer_nogpu::nogpu_txtime_now
+//  the earliest send time a datagram may get without overtaking one already queued:
+//  fq keeps each flow sorted by send time (Linux >= 5.7), so a datagram stamped "now"
+//  (CMD_AUDIO, the next CMD_BLIT...) would pass the pixel datagrams still waiting and
+//  land in the middle of the blit payload
+//============================================================
+
+uint64_t renderer_nogpu::nogpu_txtime_now()
+{
+	#if defined(__linux__)
+	timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	const uint64_t now = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+	return std::max(now, m_last_txtime);
+	#else
+	return 0;
+	#endif
+}
+
+//============================================================
+//  renderer_nogpu::nogpu_send_at
+//  (Linux, line pacing) one datagram that fq releases at txtime (CLOCK_MONOTONIC ns)
+//============================================================
+
+bool renderer_nogpu::nogpu_send_at(const char *buffer, int size, uint64_t txtime)
+{
+	#if defined(__linux__) && defined(SO_TXTIME)
+	txtime = std::max(txtime, m_last_txtime);	// never before a datagram already queued
+	m_last_txtime = txtime;
+
+	iovec iov = { (void *)buffer, (size_t)size };
+	char control[CMSG_SPACE(sizeof(uint64_t))] = {};
+	msghdr msg = {};
+	msg.msg_name = &m_server_addr;
+	msg.msg_namelen = sizeof(m_server_addr);
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+	msg.msg_control = control;
+	msg.msg_controllen = sizeof(control);
+	cmsghdr *cm = CMSG_FIRSTHDR(&msg);
+	cm->cmsg_level = SOL_SOCKET;
+	cm->cmsg_type = SCM_TXTIME;
+	cm->cmsg_len = CMSG_LEN(sizeof(uint64_t));
+	memcpy(CMSG_DATA(cm), &txtime, sizeof(txtime));
+
+	if (sendmsg(m_sockfd, &msg, 0) < 0)
+	{
+		osd_printf_verbose("nogpu_send_at failed.\n");
+		return false;
+	}
+	return true;
+	#else
+	return false;
+	#endif
+}
+
