 		osd_printf_verbose("nogpu: compression algorithm %s not supported\n", compression);
 
+	m_pacing = options.mister_pacing();
+	#if !defined(SO_MAX_PACING_RATE)
+		if (m_pacing > 0.0)
+			osd_printf_verbose("nogpu: pacing not supported on this platform\n");
+		m_pacing = 0.0;
