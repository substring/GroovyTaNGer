@@ -659,6 +733,37 @@ bool renderer_nogpu::nogpu_switch_video_mode()
 	m_period = 1000.0 / (double(mode->pclock) / (mode->htotal * mode->vtotal)) / (mode->interlace? 2: 1);
 	m_line_period = 1000.0 / mode->hfreq;
 	m_field = 0;
+
+	// Optional kernel pacing: the frame is still handed to the kernel in one go (sendto
+	// returns at once, the emulation thread never waits), but the fq qdisc releases the
+	// datagrams at the raster's line rate instead of one wire-speed burst. A receiver
+	// that races the beam with a small line buffer is then never outrun. Linux only, and
+	// the interface must use the fq qdisc (fq_codel ignores the rate), e.g.
+	//   tc qdisc replace dev <if> root fq flow_limit 1000
+	// (fq's default flow_limit of 100 packets is less than one frame).
+	#if defined(SO_MAX_PACING_RATE)
+	if (m_pacing > 0.0)
+	{
+		// bytes per raster line as fq counts them: pixels + 42 bytes of Ethernet/IPv4/UDP
+		// headers per 1472-byte datagram
+		double line_bytes = (double)m_width * m_bpp * (1472.0 + 42.0) / 1472.0;
+		uint32_t rate = (uint32_t)(line_bytes * mode->hfreq * m_pacing);
+		// Linux can only LOWER a UDP socket's pacing rate: SO_MAX_PACING_RATE does
+		// sk_pacing_rate = min(sk_pacing_rate, rate) and, unlike TCP, nothing raises it
+		// again. After a narrower mode (e.g. 256 px) a wider one stayed paced too slowly:
+		// its frames queued up, the receiver's ACKs came later every frame and the sync
+		// was lost. A fresh socket starts unlimited, so recreate it to go up.
+		if (m_pacing_rate != 0 && rate > m_pacing_rate && !nogpu_reopen_socket())
+			osd_printf_verbose("nogpu: could not reopen the socket to raise the pacing rate\n");
+		if (setsockopt(m_sockfd, SOL_SOCKET, SO_MAX_PACING_RATE, &rate, sizeof(rate)) < 0)
+			osd_printf_verbose("nogpu: could not set the pacing rate\n");
+		else
+		{
+			m_pacing_rate = rate;
+			osd_printf_verbose("nogpu: pacing %u bytes/s (%.3f x the line rate)\n", rate, m_pacing);
+		}
+	}
+	#endif
