// Groovy_Tang - Phase 1 LED blink physical constraints (Tang Primer 20K Dock).
// SPDX-License-Identifier: GPL-2.0-or-later
//
// Pins from the Sipeed reference (LED example), confirmed via the wiki:
//   https://wiki.sipeed.com/hardware/en/tang/tang-primer-20k/examples/led.html
//   - Clock      : H11  (27 MHz crystal on the core board)
//   - IO_voltage : L14  (LED on the Dock extension board)
//
// [VERIFY] Confirm H11 and L14 against YOUR board revision/schematic before
// flashing. The IO_TYPE/DRIVE lines below are conventional LVCMOS33 defaults for
// these banks and are also [VERIFY] (the Sipeed example only specifies IO_LOC).

IO_LOC  "Clock" H11;
IO_PORT "Clock" IO_TYPE=LVCMOS33;

IO_LOC  "IO_voltage" L14;
IO_PORT "IO_voltage" IO_TYPE=LVCMOS33 DRIVE=8;
