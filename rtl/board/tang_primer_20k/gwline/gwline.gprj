        <File path="../../../core/groovy_linescan.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_slotline_ram.v" type="file.verilog" enable="1"/>
        <!-- Network stack -->
        <File path="../../../vendor/sipeed_udp/PLL_6M.v" type="file.verilog" enable="1"/>
        <File path="../../../vendor/sipeed_udp/udp.sv" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_packet_parser.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_session.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_ack_policy.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_ack_sender.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_features.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_tx_arbiter.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_switchres.v" type="file.verilog" enable="1"/>
        <File path="../../../core/pclk_double_to_khz.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_pll_solver.v" type="file.verilog" enable="1"/>
        <File path="../../../generic/video/superres_factor.v" type="file.verilog" enable="1"/>
        <File path="../../../core/groovy_blit_rx.v" type="file.verilog" enable="1"/>
        <!-- Video: timing gen, DVI, UART -->
        <File path="../../../vendor/nand2mario_ddr3/uart_tx_V2.v" type="file.verilog" enable="1"/>
        <File path="../../../vendor/gowin/rpll_tmds.v" type="file.verilog" enable="1"/>
        <File path="../../../generic/video/video_timing_gen.v" type="file.verilog" enable="1"/>
        <File path="../video/dvi_tx/dvi_tx.v" type="file.verilog" enable="1"/>
        <!-- top + constraints -->
